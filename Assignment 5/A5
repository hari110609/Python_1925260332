# Summarisers: frequency O(words) vs first-k O(1)
sents = lambda t: t.split(". ")
def freq(t):
    f = Counter(t.lower().split())
    return max(sents(t), key=lambda s: sum(f[w] for w in s.lower().split()))
def first(t): return sents(t)[0]
print("Same summary:", sum(freq(t) == first(t) for t, _ in data), "/ 50")
for fn in (freq, first):
    t0 = time.time(); [fn(t) for t, _ in data * 1000]
    print(fn.__name__, "50k:", round(time.time() - t0, 3), "s")

# B4.2: index on (station, day)
db = sqlite3.connect(":memory:")
db.execute("CREATE TABLE r(station, day, pm25)")
db.executemany("INSERT INTO r VALUES (?,?,?)", ((s, d, q) for s in range(120) for d in range(30) for q in range(96)))
def run():
    t0 = time.time()
    for i in range(100): db.execute("SELECT AVG(pm25) FROM r WHERE station=? AND day=?", (i, i % 30)).fetchone()
    return time.time() - t0
a = run(); db.execute("CREATE INDEX ix ON r(station, day)"); b = run()
print(f"No index {a*1000:.0f} ms, index {b*1000:.1f} ms, {a/b:.0f}x faster")

