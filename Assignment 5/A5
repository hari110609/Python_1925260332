import re, sqlite3, time
from collections import Counter
POSITIVE = {"good", "clean", "fast", "helpful", "improved"}
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"}
NEGATORS = {"not", "never", "no"}

def score(text):
    w = text.lower().replace(".", " ").replace(",", " ").split()
    total = 0
    for i, x in enumerate(w):  # TODO 1
        v = (x in POSITIVE) - (x in NEGATIVE)
        total += -v if i and w[i-1] in NEGATORS else v
    return total

def label(t):
    s = score(t); return "positive" if s > 0 else "negative" if s < 0 else "neutral"

for c in ["Roads are clean and the bus was fast.", "Smoke from the factory, air is bad.",
          "The staff were not helpful.", "Not bad, service improved."]:
    print(f"{label(c):8} | {c}")

