# ---------------- experiment ----------------
random.seed(7)
FIRST = [
    "ravi",
    "anitha",
    "suresh",
    "meena",
    "karthik",
    "priya",
    "arun",
    "divya",
    "vijay",
    "latha",
]
LAST = ["kumar", "s", "raj", "devi", "krishnan", "babu"]


def make_contacts(n):
    people = n // 2  # so every person appears about twice
    numbers = [str(9000000000 + random.randrange(10**9)) for i in range(people)]
    formats = [
        lambda d: d,
        lambda d: "+91 " + d[:5] + " " + d[5:],
        lambda d: "0" + d,
        lambda d: "+91-" + d[:5] + "-" + d[5:],
    ]
    data = []
    for i in range(n):
        p = random.randrange(people)
        name = random.choice(FIRST) + " " + random.choice(LAST)
        email = f"user{p}@mail.com" if random.random() < 0.5 else None
        data.append((name, random.choice(formats)(numbers[p]), email))
    return data


print()
print("--- Timing (seconds) ---")
print(f"{'contacts':>9} {'people':>8} {'dictionary':>11} {'pairwise':>10}")
for n in (1000, 2000, 4000, 100000):
    data = make_contacts(n)
    t = time.perf_counter()
    m = merge_contacts(data)
    t1 = time.perf_counter() - t
    if n <= 4000:
        t = time.perf_counter()
        g = merge_pairwise(data)
        t2 = time.perf_counter() - t
        assert len(g) == len(m)
        print(f"{n:>9} {len(m):>8} {t1:>11.4f} {t2:>10.4f}")
        last = (n, t2)
    else:
        estimate = last[1] * (n / last[0]) ** 2
        print(
            f"{n:>9} {len(m):>8} {t1:>11.4f}"
            f" {'~' + format(estimate, '.0f') + ' (est.)':>10}"
        )
