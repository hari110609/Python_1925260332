import random
import time

TITLES = {"dr", "mr", "mrs", "ms", "prof", "er"}


def normalise_number(number):
    # keep only digits and take the last 10 (drops +91, 0, spaces, dashes)
    if not number:
        return ""
    digits = "".join(ch for ch in number if ch.isdigit())
    return digits[-10:] if len(digits) >= 10 else digits


def normalise_name(name):
    # lower case, no dots, no titles like Dr / Mr
    if not name:
        return ""
    words = name.lower().replace(".", " ").split()
    words = [w for w in words if w not in TITLES]
    return " ".join(words)


def normalise_email(email):
    return email.strip().lower() if email else ""


def merge_contacts(contacts):
    merged = {}  # key -> {"name": ..., "numbers": set, "emails": set}
    email_to_key = {}  # used when a contact has no phone number
    for name, number, email in contacts:
        num = normalise_number(number)
        nm = normalise_name(name)
        em = normalise_email(email)
        if num:
            key = num
        elif em and em in email_to_key:
            key = email_to_key[em]
        elif em:
            key = "email:" + em
        elif nm:
            key = "name:" + nm
        else:
            continue  # nothing useful in this contact
        person = merged.setdefault(
            key, {"name": "", "numbers": set(), "emails": set()}
        )
        if len(nm) > len(person["name"]):
            person["name"] = nm  # keep the fullest name
        if num:
            person["numbers"].add(num)
        if em:
            person["emails"].add(em)
            email_to_key.setdefault(em, key)
    return merged


def merge_pairwise(contacts):
    # alternative: compare every contact with every group made so far
    groups = []
    for name, number, email in contacts:
        num = normalise_number(number)
        nm = normalise_name(name)
        em = normalise_email(email)
        for g in groups:
            if num and num in g["numbers"]:
                break
        else:
            g = {"name": "", "numbers": set(), "emails": set()}
            groups.append(g)
        if len(nm) > len(g["name"]):
            g["name"] = nm
        if num:
            g["numbers"].add(num)
        if em:
            g["emails"].add(em)
    return groups


def show(merged):
    for key in sorted(merged, key=lambda k: merged[k]["name"]):
        p = merged[key]
        print(
            f"  {p['name'].title():14} numbers = {sorted(p['numbers'])}"
            f"  emails = {sorted(p['emails'])}"
        )


